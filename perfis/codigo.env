# Perfil: codigo — código longo, refatoração, scripts de conexão do cérebro.
# Modelo capaz, esforço alto, e no Codex o sandbox permite escrever no workspace.
# Regra de roteamento: código vai para o agente onde o repo JÁ está aberto.

DUPLO_DESCRICAO="código: modelo capaz, esforço alto, escrita no workspace"

DUPLO_CLAUDE_MODELO="fable"
DUPLO_CLAUDE_ESFORCO="high"
DUPLO_CLAUDE_EXTRA="--permission-mode acceptEdits"

DUPLO_CODEX_MODELO="gpt-6-astra"
DUPLO_CODEX_ESFORCO="high"
DUPLO_CODEX_EXTRA="-s workspace-write"
