# Perfil: padrao — o dia a dia sem pensar em modelo.
# Variáveis lidas por duplo.sh (claude/codex/uso). Ajuste ao seu plano.
#
# Claude Code: --model aceita alias (fable, opus, sonnet) ou nome completo;
#              --effort aceita low, medium, high, xhigh, max (verificado no 2.1.263).
# Codex CLI:   -m <modelo>; esforço vai por -c model_reasoning_effort="<nível>"
#              (níveis documentados publicamente: minimal, low, medium, high;
#              alguns modelos aceitam xhigh — confira na doc do seu modelo).

DUPLO_DESCRICAO="dia a dia: modelo capaz, esforço médio"

DUPLO_CLAUDE_MODELO="sonnet"
DUPLO_CLAUDE_ESFORCO="medium"
DUPLO_CLAUDE_EXTRA=""

DUPLO_CODEX_MODELO="gpt-6-astra"
DUPLO_CODEX_ESFORCO="medium"
DUPLO_CODEX_EXTRA=""
